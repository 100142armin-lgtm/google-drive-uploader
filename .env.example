# Google Drive Uploader - Environment Configuration Example
# Copy this file to .env and configure your values.
# DO NOT commit real secrets or production .env files to Git.

# Google Apps Script Web App Endpoint (Deployed as Web App)
# Example: https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
GDRIVE_WEB_APP_URL=https://script.google.com/macros/s/YOUR_SCRIPT_DEPLOYMENT_ID/exec

# Optional: Local Proxy for bypassing network restrictions (http:// or socks5://)
# Example: http://127.0.0.1:7890
GDRIVE_PROXY_URL=
